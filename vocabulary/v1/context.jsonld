{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "cps": "https://cms-provenance.org/ns/v1#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "lastSubstantiveRevision": { "@id": "cps:lastSubstantiveRevision", "@type": "xsd:dateTime" },
    "maintainedDate": { "@id": "cps:maintainedDate", "@type": "xsd:dateTime" },
    "accessDate": { "@id": "cps:accessDate", "@type": "xsd:date" },
    "cpsConformance": { "@id": "cps:cpsConformance", "@type": "xsd:integer" },
    "generator": { "@id": "cps:generator" },
    "specVersion": { "@id": "cps:specVersion" },
    "contentHash": { "@id": "cps:contentHash" },
    "signature": { "@id": "cps:signature" },
    "algorithm": { "@id": "cps:algorithm" },
    "signatureValue": { "@id": "cps:signatureValue" },
    "keyId": { "@id": "cps:keyId" },
    "key": { "@id": "cps:key", "@type": "@id" },

    "claim": { "@id": "cps:claim" },
    "subject": { "@id": "cps:subject", "@type": "@id" },
    "predicate": { "@id": "cps:predicate", "@type": "@id" },
    "object": { "@id": "cps:object" },
    "evidence": { "@id": "cps:evidence", "@type": "@id" },
    "confidence": { "@id": "cps:confidence" },
    "validUntil": { "@id": "cps:validUntil", "@type": "xsd:date" }
  }
}
